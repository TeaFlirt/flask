cd ~/flask

# Создать Dockerfile для nginx
cat > Dockerfile.nginx << 'EOF'
FROM alpine:3.19

RUN apk add --no-cache nginx

RUN mkdir -p /run/nginx /var/log/nginx

COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
EOF

# Создать минимальный nginx.conf
cat > nginx.conf << 'EOF'
events {
    worker_connections 1024;
}

http {
    upstream flask_app {
        server web:5000;
    }

    server {
        listen 80;
        server_name localhost;

        client_max_body_size 10M;

        location /static/ {
            alias /static/;
            expires 30d;
        }

        location / {
            proxy_pass http://flask_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
EOF

# Обновить docker-compose.yml
cat > docker-compose.yml << 'EOF'
services:
  mysql:
    image: mariadb:10.11
    container_name: tehnikum_mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: passwd
      MYSQL_DATABASE: tehnikum
    ports:
      - "3307:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-ppasswd"]
      timeout: 10s
      retries: 10
      interval: 10s
    networks:
      - tehnikum_network

  web:
    build: .
    container_name: tehnikum_web
    restart: always
    environment:
      - MYSQL_HOST=mysql
      - MYSQL_USER=root
      - MYSQL_PASSWORD=passwd
      - MYSQL_DB=tehnikum
    depends_on:
      mysql:
        condition: service_healthy
    volumes:
      - .:/app
      - ./app/static/images:/app/app/static/images
    networks:
      - tehnikum_network
    expose:
      - "5000"

  nginx:
    build:
      context: .
      dockerfile: Dockerfile.nginx
    container_name: tehnikum_nginx
    restart: always
    ports:
      - "8080:80"
    volumes:
      - ./app/static:/static:ro
    depends_on:
      - web
    networks:
      - tehnikum_network

networks:
  tehnikum_network:
    driver: bridge

volumes:
  mysql_data:
EOF

# Запустить
docker-compose up -d --build
