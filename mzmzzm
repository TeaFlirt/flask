## Но проблема с nginx:alpine остается.

### Решение - собрать nginx локально (как писал выше):

```bash
# Создать Dockerfile для nginx
cat > Dockerfile.nginx << 'EOF'
FROM alpine:3.19

RUN apk add --no-cache nginx

RUN mkdir -p /run/nginx /var/log/nginx

COPY nginx.conf /etc/nginx/http.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
EOF

# Создать nginx.conf
cat > nginx.conf << 'EOF'
server {
    listen 80;
    server_name localhost;

    client_max_body_size 10M;

    location /static/ {
        alias /static/;
        expires 30d;
    }

    location / {
        proxy_pass http://web:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF
```

### Изменить docker-compose.yml для использования локальной сборки nginx:

```bash
cat > docker-compose.yml << 'EOF'
services:
  mysql:
    image: mysql:8.0
    container_name: tehnikum_mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: passwd
      MYSQL_DATABASE: tehnikum
    ports:
      - "3307:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-ppasswd"]
      timeout: 10s
      retries: 10
      interval: 10s
    networks:
      - tehnikum_network

  web:
    build: .
    container_name: tehnikum_web
    restart: always
    environment:
      - MYSQL_HOST=mysql
      - MYSQL_USER=root
      - MYSQL_PASSWORD=passwd
      - MYSQL_DB=tehnikum
    depends_on:
      mysql:
        condition: service_healthy
    volumes:
      - .:/app
      - ./app/static/images:/app/app/static/images
    networks:
      - tehnikum_network
    expose:
      - "5000"

  nginx:
    build:
      context: .
      dockerfile: Dockerfile.nginx
    container_name: tehnikum_nginx
    restart: always
    ports:
      - "8080:80"
    volumes:
      - ./app/static:/static:ro
    depends_on:
      - web
    networks:
      - tehnikum_network

networks:
  tehnikum_network:
    driver: bridge

volumes:
  mysql_data:
EOF
```

### Запустить:

```bash
docker-compose up -d --build
```

Теперь:
- ✅ MySQL 8.0 (как у вас)
- ✅ nginx собран локально из Alpine Linux (не нужен Docker Hub)
- ✅ Работает на порту 8080

Проверьте:
